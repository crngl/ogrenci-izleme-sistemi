Options -Indexes
AddType application/javascript .mjs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(data|tests|node_modules|work|tmp)(/|$) - [F,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "script-src-attr 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
</IfModule>
<FilesMatch "(?i)(^\.|\.(sql|md|zip|log|docx|pdf)$|^(package(-lock)?\.json|server\.js|database\.json)$)">
  Require all denied
</FilesMatch>
